---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryCard from "../components/EntryCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { experience, learning, site, skills } from "../data/site";
import { withBase } from "../lib/site";

const publicProjects = await getCollection("projects", ({ data }) => !data.draft);
const featuredProjectIds = [
  "container-crane-automation",
  "air-conditioner-clustering",
  "vision-transformer-quantization"
];
const projects = featuredProjectIds
  .map((id) => publicProjects.find((project) => project.id === id))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));
const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() || a.data.title.localeCompare(b.data.title, "ko"))
  .slice(0, 3);
---

<BaseLayout>
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Embedded Software · ECU · Edge AI</p>
        <h1>하드웨어를 이해하고,<br /><em>신뢰할 수 있는</em><br />소프트웨어를 만듭니다.</h1>
        <p class="hero-lead">
          MCU 펌웨어와 차량용 ECU 소프트웨어를 개발해 왔습니다. 문제를 재현하고 원인을 끝까지 추적해 실제 환경에서 동작하는 시스템으로 구현합니다.
        </p>
        <div class="button-row">
          <a class="button primary" href={withBase("/resume/")}>이력서</a>
          <a class="button primary" href={withBase("/projects/")}>프로젝트</a>
          <a class="button" href={site.links.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>
      <aside class="hero-panel" aria-label="전문 분야 요약">
        <div class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <p class="panel-label">PROFILE</p>
        <dl>
          <div><dt>focus</dt><dd>ECU · Embedded Linux</dd></div>
          <div><dt>bridge</dt><dd>Hardware ↔ Software</dd></div>
          <div><dt>approach</dt><dd>Reproduce · Trace · Verify</dd></div>
          <div><dt>Education</dt><dd>전자공학(주전공) · 컴퓨터학(부전공)</dd></div>
        </dl>
        <p class="panel-status"><span></span> 기록하며 계속 개선 중</p>
      </aside>
    </div>
  </section>

  <section class="page-section section-soft" id="about">
    <div class="shell about-grid">
      <div>
        <p class="eyebrow">About</p>
        <h2>모델에서 끝내지 않고<br />실제 시스템까지.</h2>
      </div>
      <div class="about-copy">
        <p>전자공학을 주전공하고 컴퓨터학을 부전공하며 하드웨어와 소프트웨어의 기반을 함께 쌓았습니다. 현대모비스에서 조향 장치에 탑재되는 MCU 펌웨어와 OTA 소프트웨어를 개발했습니다.</p>
        <p>대학에서는 임베디드 시스템과 딥러닝을 결합한 프로젝트를 수행했습니다. 모델 학습에 그치지 않고 C++ 변환, 경량화, Embedded Linux 및 MCU 배포까지 직접 검증했습니다.</p>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Selected Work</p><h2>대표 프로젝트</h2></div>
        <a class="text-link" href={withBase("/projects/")}>전체 프로젝트 보기 →</a>
      </div>
      <div class="card-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="page-section section-soft">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Experience</p><h2>경력과 경험</h2></div>
        <a class="text-link" href={withBase("/resume/")}>전체 이력서 보기 →</a>
      </div>
      <div class="timeline">
        {experience.slice(0, 2).map((item) => (
          <article class="timeline-row">
            <time>{item.period}</time>
            <div><h3>{item.organization}</h3><strong>{item.role}</strong><p>{item.description}</p></div>
          </article>
        ))}
      </div>
      <div class="skill-strip">
        {skills.flatMap((group) => group.items).slice(0, 12).map((skill) => <span>{skill}</span>)}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Knowledge Base</p><h2>기술 글과 학습 노트</h2></div>
        <p>완성도 높은 설명은 기술 글로, 실험과 문제 해결 과정은 학습 노트로 남깁니다.</p>
      </div>
      {(posts.length > 0 || notes.length > 0) ? (
        <div class="entry-list">
          {posts.map((post) => <EntryCard kind="posts" id={post.id} title={post.data.title} description={post.data.description} publishedAt={post.data.publishedAt} tags={post.data.tags} />)}
          {notes.map((note) => <EntryCard kind="notes" id={note.id} title={note.data.title} description={note.data.description} publishedAt={note.data.publishedAt} tags={note.data.tags} />)}
        </div>
      ) : (
        <div class="empty-state">
          <strong>새로운 기록을 준비하고 있습니다.</strong><br />
          기존 글은 <a class="text-link" href={site.links.velog} target="_blank" rel="noreferrer">Velog에서 확인할 수 있습니다 ↗</a>
        </div>
      )}
      <div class="knowledge-links">
        <a href={withBase("/posts/")}><span>ARTICLE</span><strong>기술 글 모아보기</strong><b>→</b></a>
        <a href={withBase("/notes/")}><span>NOTE</span><strong>학습 노트 모아보기</strong><b>→</b></a>
      </div>
    </div>
  </section>

  <section class="page-section section-soft">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">Learning Map</p><h2>지금까지 쌓아온 기록</h2></div></div>
      <div class="learning-grid">
        {learning.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            {item.href && <a class="text-link" href={item.href} target="_blank" rel="noreferrer">저장소 보기 ↗</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section contact-band">
    <div class="shell contact-inner">
      <div><p class="eyebrow">Contact</p><h2>함께 이야기할 주제가 있나요?</h2><p>임베디드 소프트웨어, 시스템 개발과 프로젝트에 관한 연락을 기다립니다.</p></div>
      <a class="button primary" href={`mailto:${site.email}`}>이메일 보내기</a>
    </div>
  </section>
</BaseLayout>
