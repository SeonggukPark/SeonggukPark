---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { withBase } from "../lib/site";
---

<BaseLayout>
  <section class="home-hero" id="home-top">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"># Embedded Software</p>
        <h1>안녕하세요,<br /><em>박성국</em>입니다.</h1>
        <p class="hero-lead">
          새로운 기술을 배우고, 이를 실제 문제에 적용하는 것을 좋아합니다.<br />
          현재 현대모비스에서 SW 엔지니어로 근무 중입니다.
        </p>

        <nav class="home-primary-nav" aria-label="주요 페이지 바로가기">
          <div class="button-row">
            <a class="button primary" href={withBase("/resume/")}>이력서</a>
            <a class="button primary" href={withBase("/projects/")}>프로젝트</a>
            <a class="button primary" href={withBase("/posts/")}>학습 기록</a>
          </div>
          <a class="home-github-link" href={site.links.github} target="_blank" rel="noreferrer">
            GitHub ↗
          </a>
        </nav>
      </div>

      <figure class="hero-portrait">
        <img
          src={withBase("/images/notion/profile-1.jpg")}
          alt="박성국 프로필 사진"
          width="747"
          height="960"
          fetchpriority="high"
        />
      </figure>

    </div>
  </section>
</BaseLayout>
