---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, tagSlug, withBase } from "../../lib/site";

export async function getStaticPaths() {
  const entries = await getCollection("notes", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<"notes">; }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.description} type="article">
  <header class="page-hero"><div class="shell"><a class="back-link" href={withBase("/notes/")}>← 학습 노트 목록</a><p class="eyebrow">Note · {formatDate(entry.data.publishedAt)}</p><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><div class="tag-row">{entry.data.tags.map((tag) => <a class="tag" href={withBase(`/tags/${tagSlug(tag)}/`)}>{tag}</a>)}</div></div></header>
  <section class="page-section section-soft"><article class="shell prose article-prose"><Content /></article></section>
</BaseLayout>
