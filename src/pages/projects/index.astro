---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { isPublished } from "../../lib/collections";
import { sortProjects } from "../../lib/projects";

const projects = sortProjects(await getCollection("projects", isPublished));
const categories = [...new Set(projects.flatMap(({ data }) => data.categories))];
---

<BaseLayout title="프로젝트" description="임베디드 소프트웨어와 Edge AI 프로젝트 사례를 소개합니다.">
  <header class="page-hero">
    <div class="shell"><p class="eyebrow">Projects</p><h1>프로젝트</h1><p class="lead">학부 과정부터 수행해온 여러 프로젝트들을 기록한 곳입니다.</p></div>
  </header>
  <section class="page-section">
    <div class="shell">
      <div class="filter-row" aria-label="프로젝트 분야">
        <button type="button" data-project-filter="all" aria-pressed="true">ALL · {projects.length}</button>
        {categories.map((category) => <button type="button" data-project-filter={category} aria-pressed="false">{category}</button>)}
        <output class="filter-status" data-project-filter-status aria-live="polite"></output>
      </div>
      <div class="topic-grid">{projects.map((project, index) => <ProjectCard project={project} variant="topic" order={index + 1} />)}</div>
    </div>
  </section>
</BaseLayout>

<script>
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-project-filter]")];
  const projectCards = [...document.querySelectorAll<HTMLElement>("[data-project-categories]")];
  const filterStatus = document.querySelector<HTMLOutputElement>("[data-project-filter-status]");
  const validFilters = new Set(filterButtons.map((button) => button.dataset.projectFilter ?? "all"));

  function filterFromUrl() {
    const requestedFilter = new URL(window.location.href).searchParams.get("category") ?? "all";
    return validFilters.has(requestedFilter) ? requestedFilter : "all";
  }

  function applyProjectFilter(filter: string, updateUrl = false) {
    let visibleCount = 0;

    for (const card of projectCards) {
      const categories = card.dataset.projectCategories?.split("|") ?? [];
      const visible = filter === "all" || categories.includes(filter);
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    for (const button of filterButtons) {
      button.setAttribute("aria-pressed", String(button.dataset.projectFilter === filter));
    }

    if (filterStatus) filterStatus.textContent = `${visibleCount}개의 프로젝트가 표시됩니다.`;

    if (updateUrl) {
      const url = new URL(window.location.href);
      if (filter === "all") url.searchParams.delete("category");
      else url.searchParams.set("category", filter);
      window.history.pushState(null, "", url);
    }
  }

  for (const button of filterButtons) {
    button.addEventListener("click", () => applyProjectFilter(button.dataset.projectFilter ?? "all", true));
  }

  window.addEventListener("popstate", () => applyProjectFilter(filterFromUrl()));
  applyProjectFilter(filterFromUrl());
</script>
