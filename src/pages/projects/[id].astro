---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPublished } from "../../lib/collections";
import { getProjectSkillTags } from "../../lib/projectTags";
import { tagSlug, withBase } from "../../lib/site";

export async function getStaticPaths() {
  const projects = await getCollection("projects", isPublished);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props { project: CollectionEntry<"projects">; }
const { project } = Astro.props;
const { Content } = await render(project);
const tags = getProjectSkillTags(project.data.tags);
const summaryPoints = project.data.cardPoints.length > 0 ? project.data.cardPoints : [project.data.description];
---

<BaseLayout title={project.data.title} description={project.data.description} type="article">
  <header class="page-hero project-page-hero">
    <div class="shell">
      <a class="back-link" href={withBase("/projects/")}>← 프로젝트 목록</a>
      <p class="eyebrow">{project.data.categories.join(" · ")} · {project.data.period}</p>
      <h1>{project.data.title}</h1>
      <ul class="project-summary-list" aria-label="프로젝트 개요">
        {summaryPoints.map((point) => <li>{point}</li>)}
      </ul>
      {tags.length > 0 && <div class="project-hero-stack">
        <p>기술 스택</p>
        <div class="tag-row">
          {tags.map((tag) => <a class="tag" href={withBase(`/tags/${tagSlug(tag)}/`)}>{tag}</a>)}
        </div>
      </div>}
      {(project.data.repository || project.data.demo) && <div class="button-row project-hero-actions">
        {project.data.repository && <a class="button primary" href={project.data.repository} target="_blank" rel="noreferrer">GitHub ↗</a>}
        {project.data.demo && <a class="button primary" href={project.data.demo} target="_blank" rel="noreferrer">Demo ↗</a>}
      </div>}
    </div>
  </header>
  <section class="page-section section-soft">
    <div class="shell prose-layout">
      <article class="prose"><Content /></article>
      <aside class="article-aside">
        <h2>Project facts</h2>
        <dl class="fact-list">
          <div><dt>분야</dt><dd>{project.data.categories.join(" · ")}</dd></div>
          <div><dt>기간</dt><dd>{project.data.period}</dd></div>
          <div><dt>역할</dt><dd>{project.data.role}</dd></div>
        </dl>
        <div class="tag-row">{tags.map((tag) => <a class="tag" href={withBase(`/tags/${tagSlug(tag)}/`)}>{tag}</a>)}</div>
        {(project.data.repository || project.data.demo) && <div class="aside-links">
          {project.data.repository && <a class="text-link" href={project.data.repository} target="_blank" rel="noreferrer">GitHub ↗</a>}
          {project.data.demo && <a class="text-link" href={project.data.demo} target="_blank" rel="noreferrer">Demo ↗</a>}
        </div>}
      </aside>
    </div>
  </section>
</BaseLayout>
