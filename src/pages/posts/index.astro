---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SubjectTopicCard from "../../components/SubjectTopicCard.astro";
import TopicCard from "../../components/TopicCard.astro";
import { subjectTopics } from "../../data/subjectTopics";
import { topicContent } from "../../data/topicContent";
import { isPublished } from "../../lib/collections";

const topics = (await getCollection("topics", isPublished)).sort((a, b) => a.data.order - b.data.order);
const topicRecordCount = (topic: (typeof topics)[number]) =>
  (topicContent[topic.id] ?? []).reduce((count, section) => count + section.items.length, 0);
---

<BaseLayout title="학습 기록" description="Notion에서 이어 온 학습 과정과 기술 글, 문제 해결 노트를 주제별로 정리합니다.">
  <header class="page-hero"><div class="shell"><p class="eyebrow">Knowledge Archive</p><h1>학습 기록</h1><p class="lead">SW와 관련하여 학습한 내용들을 정리한 곳입니다. <br/> 모든 내용은 Notion에 수기로 정리하였으며, MCP를 활용하여 기록을 불러오고 있습니다.</p></div></header>
  <section class="page-section"><div class="shell">
    <div class="section-heading"><div><p class="eyebrow">Book Study</p><h2>도서 학습 기록</h2></div></div>
    <div class="topic-grid">{topics.map((topic) => <TopicCard topic={topic} noteCount={topicRecordCount(topic)} />)}</div>
  </div></section>
  <section class="page-section section-soft"><div class="shell">
    <div class="section-heading"><div><p class="eyebrow">Topic Notes</p><h2>주제별 기술 기록</h2></div></div>
    <div class="topic-grid">{subjectTopics.map((topic) => <SubjectTopicCard topic={topic} />)}</div>
  </div></section>
</BaseLayout>
