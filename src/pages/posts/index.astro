---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryCard from "../../components/EntryCard.astro";
import TopicCard from "../../components/TopicCard.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const topics = (await getCollection("topics", ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const notes = await getCollection("notes", ({ data }) => !data.draft);
---

<BaseLayout title="기술 글" description="Notion 스터디 플래너에서 시작한 기술 주제와 발행 콘텐츠를 주제별로 정리합니다.">
  <header class="page-hero"><div class="shell"><p class="eyebrow">Study Topics</p><h1>주제별로 배우고<br />연결해서 기록합니다.</h1><p class="lead">Notion 스터디 플래너의 학습 페이지를 기준으로 목차를 만들고, 다듬은 글과 노트를 각 주제 안에 모읍니다.</p></div></header>
  <section class="page-section"><div class="shell">
    <div class="section-heading"><div><p class="eyebrow">Topic Archive</p><h2>기술 주제</h2></div><p>완료·진행·예정 상태와 공개된 콘텐츠를 함께 확인할 수 있습니다.</p></div>
    <div class="topic-grid">{topics.map((topic) => <TopicCard topic={topic} noteCount={topic.data.noteIds.filter((id) => notes.some((note) => note.id === id)).length} />)}</div>
  </div></section>
  {posts.length > 0 && <section class="page-section section-soft"><div class="shell">
    <div class="section-heading"><div><p class="eyebrow">Articles</p><h2>최근 기술 글</h2></div></div>
    <div class="entry-list">{posts.map((post) => <EntryCard kind="posts" id={post.id} title={post.data.title} description={post.data.description} publishedAt={post.data.publishedAt} tags={post.data.tags} eyebrow={post.data.series} />)}</div>
  </div></section>}
</BaseLayout>
