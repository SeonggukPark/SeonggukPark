---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { topicContent } from "../../data/topicContent";
import { isPublished } from "../../lib/collections";
import { formatDate, tagSlug, withBase } from "../../lib/site";

type ArticleProps = { kind: "article"; entry: CollectionEntry<"posts"> };
type TopicProps = { kind: "topic"; entry: CollectionEntry<"topics"> };
type Props = ArticleProps | TopicProps;

export async function getStaticPaths() {
  const articles = await getCollection("posts", isPublished);
  const topics = await getCollection("topics", isPublished);
  return [
    ...articles.map((entry) => ({ params: { id: entry.id }, props: { kind: "article" as const, entry } })),
    ...topics.map((entry) => ({ params: { id: entry.id }, props: { kind: "topic" as const, entry } }))
  ];
}

const props = Astro.props as Props;
const { Content } = await render(props.entry);
const sourceNotes = props.kind === "topic" ? await getCollection("notes") : [];
const contentSections = props.kind === "topic"
  ? (topicContent[props.entry.id] ?? [])
      .map((section) => ({
        ...section,
        items: section.items
          .map((item) => ({ ...item, entry: sourceNotes.find((note) => note.id === item.id) }))
          .filter((item): item is typeof item & { entry: CollectionEntry<"notes"> } => Boolean(item.entry))
      }))
  : [];
---

{props.kind === "article" ? (
  <BaseLayout title={props.entry.data.title} description={props.entry.data.description} type="article">
    <header class="page-hero"><div class="shell"><a class="back-link" href={withBase("/posts/")}>← 기록 목록</a><p class="eyebrow">{props.entry.data.series ?? "Article"} · {formatDate(props.entry.data.publishedAt)}</p><h1>{props.entry.data.title}</h1><p class="lead">{props.entry.data.description}</p><div class="tag-row">{props.entry.data.tags.map((tag) => <a class="tag" href={withBase(`/tags/${tagSlug(tag)}/`)}>{tag}</a>)}</div></div></header>
    <section class="page-section section-soft"><article class="shell prose article-prose"><Content /></article></section>
  </BaseLayout>
) : (
  <BaseLayout title={props.entry.data.title} description={props.entry.data.description}>
    <header class="page-hero topic-page-hero"><div class="shell">
      <a class="back-link" href={withBase("/posts/")}>← 기술 주제 목록</a>
      <div class="topic-heading-meta"><p class="eyebrow">Study Topic · {props.entry.data.period}</p><span data-status={props.entry.data.status}>{props.entry.data.status}</span></div>
      <h1>{props.entry.data.title}</h1>
      <p class="lead">{props.entry.data.description}</p>
      <div class="tag-row">{props.entry.data.tags.map((tag) => <a class="tag" href={withBase(`/tags/${tagSlug(tag)}/`)}>{tag}</a>)}</div>
      {props.entry.data.repository && <div class="button-row topic-actions"><a class="button" href={props.entry.data.repository} target="_blank" rel="noreferrer">학습 저장소 ↗</a></div>}
    </div></header>
    {contentSections.length > 0 && <section class="page-section section-soft"><div class="shell">
      <div class="section-heading"><div><p class="eyebrow">Original Study Records</p><h2>학습 콘텐츠</h2></div><p>Notion에서 기록한 장·절 구조와 순서를 유지해 본문을 연결했습니다.</p></div>
      <div class="topic-content-tree">
        {contentSections.map((section, sectionIndex) => <section class="topic-content-section">
          <div class="topic-content-section-heading"><span>{String(sectionIndex + 1).padStart(2, "0")}</span><h3>{section.title}</h3></div>
          {section.items.length > 0 ? <ol class="topic-content-list">
            {section.items.map((item, itemIndex) => <li>
              <a href={withBase(`/posts/${props.entry.id}/${item.slug}/`)}>
                <span>{String(itemIndex + 1).padStart(2, "0")}</span>
                <div><strong>{item.label ?? item.entry.data.title}</strong><small>{item.entry.data.description}</small></div>
                <b aria-hidden="true">→</b>
              </a>
            </li>)}
          </ol> : <p class="topic-content-pending">아직 기록된 하위 콘텐츠가 없습니다.</p>}
        </section>)}
      </div>
    </div></section>}
  </BaseLayout>
)}
