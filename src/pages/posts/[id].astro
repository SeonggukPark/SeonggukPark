---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryCard from "../../components/EntryCard.astro";
import { formatDate, tagSlug, withBase } from "../../lib/site";

type ArticleProps = { kind: "article"; entry: CollectionEntry<"posts"> };
type TopicProps = { kind: "topic"; entry: CollectionEntry<"topics"> };
type Props = ArticleProps | TopicProps;

export async function getStaticPaths() {
  const articles = await getCollection("posts", ({ data }) => !data.draft);
  const topics = await getCollection("topics", ({ data }) => !data.draft);
  return [
    ...articles.map((entry) => ({ params: { id: entry.id }, props: { kind: "article" as const, entry } })),
    ...topics.map((entry) => ({ params: { id: entry.id }, props: { kind: "topic" as const, entry } }))
  ];
}

const props = Astro.props as Props;
const { Content } = await render(props.entry);
const notes = props.kind === "topic" ? await getCollection("notes", ({ data }) => !data.draft) : [];
const linkedNotes = props.kind === "topic"
  ? props.entry.data.noteIds
      .map((id) => notes.find((note) => note.id === id))
      .filter((note): note is CollectionEntry<"notes"> => Boolean(note))
  : [];
---

{props.kind === "article" ? (
  <BaseLayout title={props.entry.data.title} description={props.entry.data.description} type="article">
    <header class="page-hero"><div class="shell"><a class="back-link" href={withBase("/posts/")}>← 기술 글 목록</a><p class="eyebrow">{props.entry.data.series ?? "Article"} · {formatDate(props.entry.data.publishedAt)}</p><h1>{props.entry.data.title}</h1><p class="lead">{props.entry.data.description}</p><div class="tag-row">{props.entry.data.tags.map((tag) => <a class="tag" href={withBase(`/tags/${tagSlug(tag)}/`)}>{tag}</a>)}</div></div></header>
    <section class="page-section section-soft"><article class="shell prose article-prose"><Content /></article></section>
  </BaseLayout>
) : (
  <BaseLayout title={props.entry.data.title} description={props.entry.data.description}>
    <header class="page-hero topic-page-hero"><div class="shell">
      <a class="back-link" href={withBase("/posts/")}>← 기술 주제 목록</a>
      <div class="topic-heading-meta"><p class="eyebrow">Study Topic · {props.entry.data.period}</p><span data-status={props.entry.data.status}>{props.entry.data.status}</span></div>
      <h1>{props.entry.data.title}</h1>
      <p class="lead">{props.entry.data.description}</p>
      <div class="tag-row">{props.entry.data.tags.map((tag) => <a class="tag" href={withBase(`/tags/${tagSlug(tag)}/`)}>{tag}</a>)}</div>
      {props.entry.data.repository && <div class="button-row topic-actions"><a class="button" href={props.entry.data.repository} target="_blank" rel="noreferrer">학습 저장소 ↗</a></div>}
    </div></header>
    <section class="page-section"><div class="shell">
      <div class="section-heading"><div><p class="eyebrow">Published</p><h2>정리한 콘텐츠</h2></div><p>초안 검토를 마친 글과 학습 노트만 공개합니다.</p></div>
      {linkedNotes.length > 0 ? <div class="entry-list">{linkedNotes.map((note) => <EntryCard kind="notes" id={note.id} title={note.data.title} description={note.data.description} publishedAt={note.data.publishedAt} tags={note.data.tags} />)}</div> : <div class="empty-state">이 주제의 공개 콘텐츠를 준비하고 있습니다.<br />학습 목차와 원본 초안은 아래에서 관리합니다.</div>}
    </div></section>
    <section class="page-section section-soft"><article class="shell prose article-prose topic-prose"><Content /></article></section>
  </BaseLayout>
)}
