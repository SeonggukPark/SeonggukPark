---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ResumeHighlights from "../components/ResumeHighlights.astro";
import ResumeTimelineItem from "../components/ResumeTimelineItem.astro";
import { activities, awards, certifications, coursework, experience, personalInfo, publications, site, skills } from "../data/site";
import { isPublished, selectByIds } from "../lib/collections";
import { withBase } from "../lib/site";

const workExperience = experience.filter((item) => item.organization === "현대모비스");
const education = experience.filter((item) => item.organization === "경북대학교");
const researchExperience = experience.filter((item) => item.organization.includes("Brain AI Lab"));
const trainingOrganizations = new Set(["삼성전자 알고리즘 역량강화 교육", "LG Aimers", "CJ Remote Internship"]);
const training = activities.filter((item) => trainingOrganizations.has(item.organization));
const otherActivities = activities.filter((item) => !trainingOrganizations.has(item.organization));
const languageItems = [...certifications].sort((a, b) => b.period.localeCompare(a.period, "ko"));
const otherItems = [...publications, ...researchExperience, ...otherActivities]
  .sort((a, b) => b.period.localeCompare(a.period, "ko"));
const publicProjects = await getCollection("projects", isPublished);
const resumeProjectIds = [
  "container-crane-automation",
  "pcb-defect-detection",
  "air-conditioner-clustering",
  "mcu-human-detection",
  "vision-transformer-quantization"
];
const resumeProjects = selectByIds(publicProjects, resumeProjectIds);
---

<BaseLayout title="이력서" description="임베디드 소프트웨어 엔지니어 박성국의 경력과 기술 이력입니다.">
  <header class="page-hero">
    <div class="shell resume-hero-grid">
      <div>
        <p class="eyebrow">Resume</p>
        <h1>{site.name}</h1>
        <dl class="resume-hero-personal">
          <div><dt>전화번호</dt><dd><a href={`tel:${personalInfo.phone.replaceAll("-", "")}`}>{personalInfo.phone}</a></dd></div>
          <div><dt>생년월일</dt><dd>{personalInfo.birthDate || "—"}</dd></div>
          <div><dt>이메일</dt><dd><a href={`mailto:${personalInfo.email}`}>{personalInfo.email}</a></dd></div>
        </dl>
        <div class="button-row">
          <a class="button" href={site.links.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>
      <img class="resume-profile" src={withBase("/images/notion/profile-1.jpg")} alt="박성국 프로필 사진" width="180" height="225" />
    </div>
  </header>
  <section class="page-section section-soft">
    <div class="shell">
      <section class="resume-section">
        <div class="resume-heading"><h2>기술 스택</h2></div>
        <div class="resume-skills resume-skills-top">
          {skills.map((group) => <article><h3>{group.name}</h3><div class="tag-row">{group.items.map((item) => <span class="tag">{item}</span>)}</div></article>)}
        </div>
      </section>
      <section class="resume-section">
        <div class="resume-heading"><h2>학력</h2></div>
        {education.map((item) => (
          <ResumeTimelineItem item={item} emphasizePoints>
            <details class="resume-coursework">
              <summary>주요 이수 과목 <span aria-hidden="true"></span></summary>
              <div class="resume-coursework-table-wrap">
                <table>
                  <thead><tr><th>이수 시기</th><th>과목명</th><th>성적</th></tr></thead>
                  <tbody>
                    {coursework.map((course) => (
                      <tr><td>{course.period}</td><td>{course.name}</td><td>{course.grade}</td></tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </ResumeTimelineItem>
        ))}
      </section>
      <section class="resume-section">
        <div class="resume-heading"><h2>경력</h2></div>
        {workExperience.map((item) => <ResumeTimelineItem item={item} emphasizePoints />)}
      </section>
      <section class="resume-section">
        <div class="resume-heading"><h2>프로젝트</h2></div>
        {resumeProjects.map((project) => (
          <article class="resume-item">
            <time>{project.data.period}</time>
            <div>
              <h3>{project.data.title}</h3>
              <strong>{project.data.category} · {project.data.role}</strong>
              <p>{project.data.description}</p>
              <ResumeHighlights items={project.data.outcomes} />
              <div class="tag-row resume-project-tags">{project.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
              <div class="resume-item-links"><a href={withBase(`/projects/${project.id}/`)}>프로젝트 상세 →</a></div>
            </div>
          </article>
        ))}
      </section>
      <section class="resume-section">
        <div class="resume-heading"><h2>교육</h2></div>
        {training.map((item) => <ResumeTimelineItem item={item} plainOrganization />)}
      </section>
      <section class="resume-section">
        <div class="resume-heading"><h2>수상</h2></div>
        {awards.map((item) => <ResumeTimelineItem item={item} />)}
      </section>
      <section class="resume-section">
        <div class="resume-heading"><h2>어학</h2></div>
        {languageItems.map((item) => <ResumeTimelineItem item={item} />)}
      </section>
      <section class="resume-section">
        <div class="resume-heading"><h2>기타</h2></div>
        {otherItems.map((item) => <ResumeTimelineItem item={item} />)}
      </section>
    </div>
  </section>
</BaseLayout>
