---
interface Props {
  items?: readonly string[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <section class="resume-highlights" aria-label="주요 성과 및 활동">
    <h4><span aria-hidden="true">↗</span>주요 성과 및 활동</h4>
    <ul>{items.map((item) => <li>{item}</li>)}</ul>
  </section>
)}
