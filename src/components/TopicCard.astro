---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../lib/site";

interface Props {
  topic: CollectionEntry<"topics">;
  noteCount: number;
}

const { topic, noteCount } = Astro.props;
const cardPoints = topic.data.cardPoints.length > 0 ? topic.data.cardPoints : [topic.data.description];
---

<a class="topic-card" href={withBase(`/posts/${topic.id}/`)}>
  <div class="topic-card-meta">
    <span>{String(topic.data.order).padStart(2, "0")}</span>
    <strong data-status={topic.data.status}>{topic.data.status}</strong>
  </div>
  <h2>{topic.data.title}</h2>
  <ul class="topic-card-points">
    {cardPoints.map((point) => <li>{point}</li>)}
  </ul>
  <div class="topic-card-footer">
    <span>{topic.data.period}</span>
    <span>연결된 기록 {noteCount}개</span>
  </div>
  <span class="card-link">주제 페이지 열기 <span aria-hidden="true">→</span></span>
</a>
